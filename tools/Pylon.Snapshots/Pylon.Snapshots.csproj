<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders each Pylon window offscreen (Avalonia headless + Skia) with made-up data and saves PNGs to captures/.
       No desktop screenshot, so nothing else on screen is ever captured. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>pylon-snapshots</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pylon.App\Pylon.App.csproj" />
    <ProjectReference Include="..\Pylon.FakeGitHub\Pylon.FakeGitHub.csproj" />
  </ItemGroup>

</Project>
